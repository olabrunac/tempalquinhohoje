DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
ADMIN_PASSWORD=coloque-uma-senha-forte-aqui

# --- Auto-post do Story no Instagram (opcional; sem isso o cron só não publica) ---
# IG_USER_ID e IG_ACCESS_TOKEN: Instagram Login (conta profissional) com
# instagram_business_basic + instagram_business_content_publish.
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v23.0
# CRON_SECRET: a Vercel manda "Authorization: Bearer $CRON_SECRET" sozinha no cron.
CRON_SECRET=
# Base pública usada pra montar a URL da imagem que a Meta baixa.
STORY_BASE_URL=https://tempalquinhohoje.com
